{
  "template": {
    "slug": "gemini-template",
    "display_name": "Gemini",
    "description": "Google account model through Browser AI Bridge",
    "supports_reasoning_summaries": false,
    "default_reasoning_summary": "none",
    "default_reasoning_level": "medium",
    "supported_reasoning_levels": [
      {
        "effort": "low",
        "description": "Fast responses with lighter reasoning"
      },
      {
        "effort": "medium",
        "description": "Balanced speed and reasoning"
      },
      {
        "effort": "high",
        "description": "Deeper reasoning for complex tasks"
      }
    ],
    "shell_type": "shell_command",
    "visibility": "list",
    "supported_in_api": true,
    "priority": 1,
    "model_messages": {
      "instructions_template": "You are Codex, a coding agent powered by Gemini. You and the user share one workspace. Use the tools supplied by Codex to inspect files, run commands, edit code, and verify the result. Keep the user informed while working, make reasonable progress without unnecessary questions, preserve unrelated user changes, and finish the requested task before yielding. Be concise, accurate, and explicit about uncertainty.",
      "instructions_variables": null,
      "approvals": null
    },
    "support_verbosity": false,
    "default_verbosity": null,
    "apply_patch_tool_type": "freeform",
    "web_search_tool_type": "text_and_image",
    "truncation_policy": {
      "mode": "tokens",
      "limit": 10000
    },
    "supports_parallel_tool_calls": true,
    "supports_image_detail_original": true,
    "context_window": 1000000,
    "max_context_window": 1000000,
    "experimental_supported_tools": [],
    "input_modalities": [
      "text",
      "image"
    ],
    "supports_search_tool": true,
    "use_responses_lite": false
  }
}
